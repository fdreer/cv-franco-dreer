---
import GitHub from '@/icons/GitHub.astro'
import Square from '../ui/Square.astro'
import cvData from '@/data/cv.json'

import '@/components/buttons/styles.css'

const cv = cvData as CvData
---

<Square>
    <a
        class="social-button"
        href=`${cv.links.github}`
        target="_blank"
        title=`Visitar perfil de ${cv.nombre} en GitHub`
    >
        <GitHub />
    </a>
</Square>
