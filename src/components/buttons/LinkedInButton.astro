---
import LinkedIn from '@/icons/LinkedIn.astro'
import Square from '../ui/Square.astro'

import '@/components/buttons/styles.css'
import cvData from '@/data/cv.json'

const cv = cvData as CvData
---

<Square>
	<a
		class="social-button"
		href=`${cv.links.linkedin}`
		target="_blank"
		title=`Visitar perfil de ${cv.nombre} en LinkedIn`
	>
		<LinkedIn />
	</a>
</Square>
