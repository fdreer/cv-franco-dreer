---
import cvData from '@/data/cv.json'

const cv = cvData as CvData
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex" />
        <title>CV — {cv.nombre}</title>
    </head>
    <body>
        <main class="cv">
            <header>
                <h1>{cv.nombre}</h1>
                <p class="role">{cv.titulo}</p>
                <p class="subtitle">{cv.subtitulo}</p>
                <address class="contact">
                    <span>{cv.ubicacion}</span>
                    <a href={`tel:${cv.telefono}`}>{cv.telefono}</a>
                    <a href={`mailto:${cv.email}`}>{cv.email}</a>
                    <a href={cv.links.linkedin}>LinkedIn: linkedin.com/in/francodreer</a>
                    <a href={cv.links.github}>GitHub: github.com/fdreer</a>
                </address>
            </header>

            <section>
                <h2>Perfil profesional</h2>
                <p>{cv.perfil}</p>
            </section>

            <section>
                <h2>Experiencia laboral</h2>
                {cv.experiencia.map(({ rol, empresa, periodo, bullets }) => (
                    <article class="experience">
                        <h3>{rol}</h3>
                        <p class="meta"><strong>{empresa}</strong> · {periodo}</p>
                        <ul>
                            {bullets.map(bullet => <li>{bullet}</li>)}
                        </ul>
                    </article>
                ))}
            </section>

            <section>
                <h2>Formación académica</h2>
                {cv.formacion.map(({ titulo, institucion, periodo }) => (
                    <article class="education">
                        <h3>{titulo}</h3>
                        <p>{institucion} · {periodo}</p>
                    </article>
                ))}
            </section>

            <section>
                <h2>Certificaciones y formación complementaria</h2>
                {cv.cursos.map(({ titulo, institucion, periodo, detalle }) => (
                    <article class="education">
                        <h3>{titulo}</h3>
                        <p>{institucion} · {periodo}</p>
                        {detalle && <p class="detail">{detalle}</p>}
                    </article>
                ))}
            </section>

            <section class="skills">
                <h2>Competencias técnicas</h2>
                {cv.competencias.map(({ categoria, items }) => (
                    <div class="skill-group">
                        <h3>{categoria}</h3>
                        <p>{items.join(' · ')}</p>
                    </div>
                ))}
            </section>

            <section>
                <h2>Idiomas</h2>
                <p>{cv.idiomas}</p>
            </section>
        </main>

        <style is:global>
            :root {
                --ink: #17201d;
                --body: #303a36;
                --muted: #5f6c67;
                --accent: #1f5d4c;
                --rule: #cfd8d4;
            }

            *,
            *::before,
            *::after {
                box-sizing: border-box;
            }

            html,
            body {
                margin: 0;
                padding: 0;
            }

            body {
                background: #eceeea;
                color: var(--body);
                font-family: Arial, Helvetica, sans-serif;
                font-size: 10.5pt;
                line-height: 1.42;
            }

            .cv {
                width: 210mm;
                margin: 24px auto;
                padding: 16mm;
                background: #fff;
                box-shadow: 0 3px 24px rgb(21 32 28 / 10%);
            }

            header {
                border-bottom: 2px solid var(--accent);
                padding-bottom: 4mm;
                margin-bottom: 5mm;
            }

            h1 {
                margin: 0;
                color: var(--ink);
                font-size: 25pt;
                line-height: 1.05;
            }

            .role {
                margin: 2mm 0 0;
                color: var(--accent);
                font-size: 14pt;
                font-weight: 700;
            }

            .subtitle {
                margin: 0.8mm 0 0;
                color: var(--ink);
                font-size: 10.5pt;
                font-weight: 600;
            }

            .contact {
                display: block;
                margin-top: 3mm;
                color: var(--muted);
                font-size: 9pt;
                font-style: normal;
                line-height: 1.55;
            }

            .contact span,
            .contact a {
                color: inherit;
                text-decoration: none;
            }

            .contact span:not(:last-child)::after,
            .contact a:not(:last-child)::after {
                content: ' · ';
                color: var(--rule);
            }

            section {
                margin-bottom: 4.5mm;
            }

            section:last-child {
                margin-bottom: 0;
            }

            h2 {
                margin: 0 0 2.3mm;
                padding-bottom: 1mm;
                border-bottom: 1px solid var(--rule);
                color: var(--ink);
                font-size: 11.5pt;
                line-height: 1.2;
            }

            h3,
            p,
            ul {
                margin-top: 0;
            }

            section > p {
                margin-bottom: 0;
            }

            .experience {
                break-inside: avoid;
                margin-bottom: 3.5mm;
            }

            .experience:last-child {
                margin-bottom: 0;
            }

            .experience h3,
            .education h3,
            .skill-group h3 {
                margin-bottom: 0.5mm;
                color: var(--ink);
                font-size: 10.8pt;
                line-height: 1.25;
            }

            .meta {
                margin-bottom: 1.5mm;
                color: var(--accent);
                font-size: 9.5pt;
            }

            ul {
                margin-bottom: 0;
                padding-left: 5mm;
            }

            li {
                margin-bottom: 0.8mm;
                padding-left: 0.5mm;
            }

            li:last-child {
                margin-bottom: 0;
            }

            .skill-group {
                break-inside: avoid;
                margin-bottom: 2.2mm;
            }

            .skill-group:last-child {
                margin-bottom: 0;
            }

            .skill-group h3 {
                color: var(--accent);
            }

            .skill-group p,
            .education p {
                margin-bottom: 0;
            }

            .education {
                break-inside: avoid;
                margin-bottom: 2.5mm;
            }

            .education:last-child {
                margin-bottom: 0;
            }

            .education p {
                color: var(--muted);
                font-size: 9.5pt;
            }

            .education .detail {
                margin-top: 0.8mm;
                color: var(--body);
            }

            @page {
                size: A4;
                margin: 15mm 16mm;
            }

            @media print {
                body {
                    background: #fff;
                }

                .cv {
                    width: auto;
                    margin: 0;
                    padding: 0;
                    box-shadow: none;
                }

                header,
                h2 {
                    break-after: avoid;
                }

                .skills {
                    break-before: page;
                }
            }
        </style>
    </body>
</html>
