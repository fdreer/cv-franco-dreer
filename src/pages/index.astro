---
import Layout from '@/layouts/Layout.astro'
import GeneralInfo from '@/sections/GeneralInfo.astro'
import Formation from '@/sections/Formation.astro'
import ProfessionalProfile from '@/sections/ProfessionalProfile.astro'
import Courses from '@/sections/Courses.astro'
import Experience from '@/sections/Experience.astro'
import cvData from '@/data/cv.json'

const cv = cvData as CvData
---

<Layout title=`Cv de ${cv.nombre}`>
    <GeneralInfo />
    <ProfessionalProfile />
    <Experience />
    <Formation />
    <Courses />
</Layout>
