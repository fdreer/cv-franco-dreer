---
import Container from '@/components/ui/Container.astro'
import LinkedIn from '@/icons/LinkedIn.astro'
import GitHub from '@/icons/GitHub.astro'
import Cv from '@/icons/Cv.astro'
import { Image } from 'astro:assets'
import myPhoto from '@/assets/img/foto.jpeg'
import LikeButton from '@/components/buttons/LikeButton.astro'
import ViewsCounter from '@/components/ViewsCounter.astro'
import cvData from '@/data/cv.json'

const cv = cvData as CvData
---

<Container>
    <section class="info">
        <div class="head">
            <article class="me">
                <h1>{cv.nombre}</h1>
                <p class="role">{cv.titulo}</p>
                <footer>
                    <a href={cv.links.linkedin} target="_blank" class="link-btn" title="LinkedIn">
                        <LinkedIn /> LinkedIn
                    </a>
                    <a href={cv.links.github} target="_blank" class="link-btn" title="GitHub">
                        <GitHub /> GitHub
                    </a>
                    <a href={cv.links.cv_pdf} target="_blank" class="link-btn link-btn--cv" title="Descargar CV">
                        <Cv /> Descargar CV
                    </a>
                    <div class="stats-row">
                        <LikeButton />
                        <ViewsCounter />
                    </div>
                </footer>
            </article>
            <figure class="photo-col">
                <Image
                    src={myPhoto}
                    alt=`Foto 4x4 de ${cv.nombre}`
                    class="my-photo"
                />
            </figure>
        </div>

        <div class="meta">
            <span>{cv.ubicacion}</span>
            <a href={`mailto:${cv.email}`} class="meta-link">{cv.email}</a>
        </div>
    </section>
</Container>

<style>
    /* El header sigue el sistema del CV impreso (src/pages/cv-print.astro):
       nombre grande, subtítulo liviano en una línea, y una fila de datos en
       mono con etiquetas. Sin iconos: la etiqueta ya dice qué es cada dato. */
    .head {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1.5rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--color-primary);
    }
    .me {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }
    h1 {
        font-size: 2.6rem;
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 0.98;
        color: var(--color-primary);
    }
    .role {
        margin-top: 0.55rem;
        font-size: 0.92rem;
        font-weight: 500;
        letter-spacing: -0.005em;
        color: var(--color-text);
        text-wrap: pretty;
    }

    /* Solo la foto: la fila de like/views vive abajo con los botones, para no
       estrangular la columna de texto y forzar al subtítulo a partirse. */
    .photo-col {
        flex-shrink: 0;
        line-height: 0;
    }
    .my-photo {
        border-radius: 50%;
        width: 96px;
        height: 96px;
        object-fit: cover;
        box-shadow: 0 0 0 1px var(--color-border);
    }
    .stats-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-left: auto;
    }

    /* Ubicación y mail, en mono como el resto de los metadatos de la página. */
    .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.75rem;
        padding-top: 0.85rem;
        /* sin borde inferior: la regla la pone el .data de la sección siguiente */
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--color-text);
    }
    .meta-link {
        color: inherit;
        transition: color 0.15s ease;
    }
    .meta-link:hover {
        color: var(--color-accent);
    }

    footer {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 1.1rem;
    }
    .link-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 14px;
        border-radius: 999px;
        border: 1px solid var(--color-border);
        color: var(--color-text);
        font-size: 0.8rem;
        font-weight: 500;
        transition:
            border-color 0.15s ease,
            color 0.15s ease,
            background 0.15s ease;
    }
    .link-btn :global(svg) {
        width: 15px;
        height: 15px;
        flex-shrink: 0;
    }
    .link-btn:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
    }
    .link-btn--cv {
        border-color: var(--color-accent);
        color: var(--color-accent);
        background: var(--color-accent-light);
    }
    .link-btn--cv:hover {
        background: var(--color-accent);
        color: var(--bg-card);
    }

    @media (width <= 700px) {
        .head {
            flex-direction: column-reverse;
            align-items: center;
            gap: 1rem;
        }
        .me {
            align-items: center;
            text-align: center;
            width: 100%;
        }
        h1 {
            font-size: 1.9rem;
        }
        .role {
            text-wrap: pretty;
        }
        footer {
            justify-content: center;
            width: 100%;
        }
        .stats-row {
            margin-left: 0;
        }
        .meta {
            justify-content: center;
        }
    }
</style>
