---
import Container from '@/components/ui/Container.astro'
import cvData from '@/data/cv.json'

const cv = cvData as CvData
---

<Container>
    <section class="data">
        <h2>Perfil profesional</h2>
        <p>{cv.perfil}</p>
    </section>
</Container>

<style>
    p {
        font-size: 1rem;
        color: var(--color-text);
        line-height: 1.7;
    }
</style>
